{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mragentes.com.ar/schemas/red-baseline-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "generated_at", "git", "environment", "counts", "requirements"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "index_digest"],
      "properties": {
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "index_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "node", "name_max"],
      "properties": {
        "python": {"type": "string"},
        "node": {"type": "string"},
        "name_max": {"type": "integer", "minimum": 1}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["red_expected", "baseline_green", "external_blocked", "errors"],
      "properties": {
        "red_expected": {"type": "integer", "minimum": 0},
        "baseline_green": {"type": "integer", "minimum": 0},
        "external_blocked": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0}
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "nodeids", "fingerprints"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["RED_EXPECTED", "BASELINE_GREEN", "EXTERNAL_BLOCKED", "ERROR"]},
          "nodeids": {"type": "array", "items": {"type": "string"}},
          "fingerprints": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
