# ---------------------------------------------------------------------------
# MR Agentes — variables de entorno
#
# Copiar a `.env` (que está en .gitignore y NO se versiona nunca) y completar.
#   cp .env.example .env
#
# En GitHub Actions no hace falta este archivo: las mismas claves van como
# «Secrets» del repositorio (Settings → Secrets and variables → Actions).
# ---------------------------------------------------------------------------

# ── Meta (Facebook + Instagram) ────────────────────────────────────────────
# Token de página de larga duración. Permisos necesarios:
#   pages_manage_posts, pages_read_engagement,
#   instagram_basic, instagram_content_publish
META_ACCESS_TOKEN=

# ID numérico de la página de Facebook (Configuración → Información de la página)
FB_PAGE_ID=

# ID de la cuenta profesional de Instagram vinculada a esa página.
# Se obtiene con:  GET /v26.0/<FB_PAGE_ID>?fields=instagram_business_account
IG_USER_ID=

# Versión de la Graph API. Subirla cuando Meta deprecie la actual.
META_GRAPH_VERSION=v26.0

# ── Interruptores del social manager ───────────────────────────────────────
# 0 apaga la publicación sin desinstalar nada.
SOCIAL_ENABLED=1

# 1 renderiza y muestra el texto, pero no llama a la API. Ideal para probar.
SOCIAL_DRY_RUN=0

# 1 hace que publish_daily.py / publish_blog.py publiquen en redes desde tu
# máquina. Dejalo en 0 si querés que publique GitHub Actions (recomendado):
# si están los dos, la nota se puede postear dos veces.
SOCIAL_LOCAL_PUBLISH=0

# Base pública desde la que Meta descarga las piezas. Vacío = se resuelve solo
# (primero raw.githubusercontent.com, después el sitio).
SOCIAL_IMAGE_BASE=

SITE_BASE_URL=https://mragentes.com.ar
SOCIAL_HANDLE=@mragentes

# ── Avisos web push (Cloudflare Worker) ────────────────────────────────────
# Lo que hoy vive en scripts/config.local.json. Cualquiera de los dos sirve.
PUSH_WORKER_URL=
PUSH_API_TOKEN=
