{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mragentes.com.ar/schemas/blog-draft-v1.schema.json",
  "title": "MR Agentes automated blog front matter",
  "description": "Closed front-matter contract for one automated MR Agentes note.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "date",
    "description",
    "image",
    "image_alt",
    "tags",
    "pillar",
    "learning_level",
    "sources",
    "automation_id",
    "draft",
    "aliases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T12:00:00-03:00$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^<>]+$"
    },
    "image": {
      "type": "string",
      "pattern": "^/images/stock/[A-Za-z0-9][A-Za-z0-9._/-]*\\.(?:webp|png|jpe?g)$",
      "maxLength": 512
    },
    "image_alt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^<>]+$"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 50
      }
    },
    "pillar": {
      "type": "string",
      "enum": [
        "automatizacion-practica",
        "control-y-gobernanza",
        "casos-para-pymes"
      ]
    },
    "learning_level": {
      "type": "string",
      "enum": ["inicial", "intermedio", "avanzado"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://",
        "maxLength": 2048
      }
    },
    "automation_id": {
      "type": "string",
      "pattern": "^blog:\\d{4}-\\d{2}-\\d{2}:[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 400
    },
    "draft": {
      "const": false
    },
    "aliases": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/notas/[A-Za-z0-9._/-]+/$",
        "maxLength": 512
      }
    }
  }
}
