{
  "name": "mragentes-site-test-harness",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.19.0"
  },
  "scripts": {
    "test": "npm run test:js",
    "test:js": "vitest run --config tests-js/vitest.config.mjs",
    "test:js:collect": "vitest list --config tests-js/vitest.config.mjs",
    "test:js:coverage": "vitest run --coverage --config tests-js/vitest.config.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.6.16",
    "@cloudflare/workers-types": "5.20260826.1",
    "@types/node": "18.19.123",
    "@vitest/coverage-v8": "2.1.9",
    "jsdom": "24.1.3",
    "typescript": "5.5.4",
    "vitest": "2.1.9",
    "yaml": "2.5.1"
  }
}
